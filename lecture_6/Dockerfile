# Используем официальный образ Python 3.13 Указываем конкретную минорную версию и ОС
FROM python:3.13.9
# Устанавливаем рабочую директорию
WORKDIR /app
# Копируем файлы проекта из текущей папки в /app внутри контейнера
COPY . .
# Устанавливаем зависимости
RUN pip install -r requirements.txt
# Запускаем приложение
CMD ["python", "homework_docker.py"]